<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyVersion>8.0.1</AssemblyVersion>
    <FileVersion>8.0.0.0</FileVersion>
    <Version>8.0.1</Version>
    <InformationalVersion>8.0.1</InformationalVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Paul Seal</Authors>
    <ContentTargetFolders>.</ContentTargetFolders>
    <Product>CleanV18.Core</Product>
    <PackageId>CleanV18.Core</PackageId>
    <Title>CleanV18.Core</Title>
    <Description>Core Library for the CleanV18 Starter Kit for Umbraco</Description>
    <PackageTags>umbraco plugin package starter kit CleanV18 core library</PackageTags>
    <PackageProjectUrl>https://github.com/prjseal/CleanV18</PackageProjectUrl>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/prjseal/CleanV18</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="18.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../images/logo.png" Pack="true" PackPath="\" />
    <None Include="../../README.md" Pack="true" PackPath="\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="TagHelpers\" />
  </ItemGroup>
</Project>