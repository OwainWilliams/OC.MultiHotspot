{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "12faaf67-2a5b-4341-a0ad-d5ab3d7b41c1",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual",
        "AcceptUnsafeModelsDirectory": true,
        "ModelsDirectory": "~/../CleanV18.Models"
      },
      "Imaging": {
        "HMACSecretKey": "UaC8Ma1ROGfcrdzttjBr/Ce1BIGzujDXLLOkMfJYk5bNXqIRl/f/vHtSG2HNV5dKHu9D40G0F8TLxSmeHMso6g=="
      }
    }
  },
  "NextJs": {
    "Revalidate": {
      "Enabled": false,
      "WebHookUrls": "[\u0022http://localhost:3000/api/revalidate\u0022]",
      "WebHookSecret": "SOMETHING_SECRET"
    }
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": ""
  }
}